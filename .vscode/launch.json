{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Vite dev",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "listening on (https?://\\S+|\\d+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}